{
  "expo": {
    "name": "GC ETA",
    "slug": "gc-eta",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "gceta",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EFE6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gceta.app"
    },
    "android": {
      "package": "com.gceta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E6B63"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "./plugins/withPodDeploymentTarget",
        {
          "target": "16.4"
        }
      ],
      "expo-font"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "fae47e1b-6f8c-422a-b505-0e497bd5047f"
      }
    },
    "owner": "sandeepnagra"
  }
}
